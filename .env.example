# ═══════════════════════════════════════════════════════════════
# MOTEROS SPORTS LINE - PLANTILLA DE VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════════
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores de ejemplo con tus claves reales
# 3. NUNCA subas el archivo .env a GitHub
# ═══════════════════════════════════════════════════════════════

# SUPABASE
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# GROQ API KEYS
GROQ_API_KEY_INDEX=gsk_tu_key_para_index_aqui
GROQ_API_KEY_ADMIN=gsk_tu_key_para_admin_aqui
GROQ_API_KEY_TIENDA=gsk_tu_key_para_tienda_aqui
GROQ_API_KEY_POS=gsk_tu_key_para_pos_aqui

# GROQ EXTRAS (Opcional - Keys de respaldo)
GROQ_EXTRA_1=gsk_extra_key_1
GROQ_EXTRA_2=gsk_extra_key_2
GROQ_EXTRA_3=gsk_extra_key_3
GROQ_EXTRA_4=gsk_extra_key_4

# AI MODEL
AI_MODEL=llama-3.3-70b-versatile
