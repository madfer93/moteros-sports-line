# ═══════════════════════════════════════════════════════════════
# MOTEROS SPORTS LINE - PLANTILLA DE VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════════
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores de ejemplo con tus claves reales
# 3. NUNCA subas el archivo .env a GitHub
# ═══════════════════════════════════════════════════════════════

# SUPABASE
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# GROQ API KEYS (Se configuran ahora como Secretos en Supabase Edge Functions)
# Ya no es necesario incluirlas en este archivo local.
# GROQ_API_KEY_INDEX=
# GROQ_API_KEY_ADMIN=
# GROQ_API_KEY_TIENDA=
# GROQ_API_KEY_POS=

# GROQ EXTRAS (Opcional - Keys de respaldo)
# GROQ_EXTRA_1=
# GROQ_EXTRA_2=
# GROQ_EXTRA_3=
# GROQ_EXTRA_4=

# AI MODEL
AI_MODEL=llama-3.3-70b-versatile
